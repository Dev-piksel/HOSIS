# ====================================================================
# HOSIS - Hotel Operations & Services Integrated System
# Backend Environment Configuration
# ====================================================================

# Port for the Express backend API
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed CORS frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Secret key for signing JWT tokens (minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-for-hosis-project-grand-horizon-2026-auth

# JWT token expiration time
JWT_EXPIRES_IN=8h

# Hotel default IANA time zone
DB_TIME_ZONE=Asia/Manila

# Salt rounds for password hashing with bcrypt
BCRYPT_ROUNDS=12

# ====================================================================
# DATABASE HOSTING OPTIONS (Choose one and set as DATABASE_URL)
# ====================================================================

# 1. SUPABASE (AWS Pooler - Recommended for Cloud Hosting)
# Replace [PASSWORD] and [PROJECT_REF] with your Supabase credentials:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Or Supabase Session Mode:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 2. NEON SERVERLESS POSTGRESQL
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require

# 3. RENDER / RAILWAY POSTGRESQL
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB_NAME]

# 4. LOCAL POSTGRESQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hosis

# Current active database connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hosis
